{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Compile Hexora with Maven Wrapper",
			"type": "shell",
			"command": ".\mvnw.cmd -B -ntp compile",
			"options": { "cwd": "${workspaceFolder}/hexora" },
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start Hexora MySQL database",
			"type": "shell",
			"command": "docker",
			"args": ["compose", "--env-file", "hexora/.env", "-f", "hexora/docker-compose.yml", "up", "-d"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Hexora app with Maven Wrapper",
			"type": "shell",
			"command": ".\mvnw.cmd spring-boot:run",
			"options": { "cwd": "${workspaceFolder}/hexora" },
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}
