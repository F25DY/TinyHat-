# Base de datos (Docker: docker-compose.yml crea el usuario DB_USER con todos los privilegios sobre DB_NAME).
DB_ROOT_PASSWORD=
DB_NAME=hexora_db
# Usuario de EJECUCION de la aplicacion: solo SELECT/INSERT/UPDATE/DELETE (ver docs/security/db-privilegios.md).
DB_USER=
DB_PASSWORD=
# Usuario de MIGRACION (Flyway) con privilegios de esquema. Obligatorio y distinto de DB_USER en prod.
FLYWAY_DB_USER=
FLYWAY_DB_PASSWORD=

NVD_API_KEY=
MYMEMORY_EMAIL=
# 32 bytes aleatorios en Base64 (por ejemplo: openssl rand -base64 32). Obligatoria.
TINYHAT_MFA_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# HTTPS local (ver docs/security/https-local.md). Con HTTPS, usa el puerto 8443 para que
# el origen https://localhost:8443 coincida con tinyhat.security.ws.allowed-origins y la CSP.
# TINYHAT_SSL_ENABLED=true
# TINYHAT_SSL_KEY_STORE=file:./local-dev.p12
# TINYHAT_SSL_KEY_STORE_PASSWORD=
# APP_PORT=8443
# PUBLIC_BASE_URL=https://localhost:8443

# Production-only required values (set these before using the prod profile):
# DB_URL=jdbc:mysql://db-host:3306/hexora_db
# SERVER_ADDRESS=0.0.0.0
# FLYWAY_DB_URL=jdbc:mysql://db-host:3306/hexora_db
# FLYWAY_DB_USER=
# FLYWAY_DB_PASSWORD=
# TINYHAT_SSL_ENABLED=true
# TINYHAT_SSL_KEY_STORE=file:/path/to/production.p12
# TINYHAT_SSL_KEY_STORE_PASSWORD=
# TINYHAT_MFA_KEY=<generate-a-unique-secret>
# PUBLIC_BASE_URL=https://tu-dominio
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_AUTH=true
# SMTP_STARTTLS_ENABLE=true
# SMTP_STARTTLS_REQUIRED=true
# SMTP server identity checking is always enabled; TLS 1.2/1.3 is required.
